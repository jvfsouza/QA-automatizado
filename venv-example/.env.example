# Copie esta pasta para `venv/` e renomeie este arquivo para `.env`.
# Nome que o bot de atendimento pede no início da conversa.
NOME=Fulano de Tal
# Mensagens enviadas no início de toda conversa, separadas por |. {nome} vira o valor de NOME.
# Deixe vazio se o bot não pedir nada antes das perguntas.
MENSAGENS_INICIAIS={nome}|Sim
